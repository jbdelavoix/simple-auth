# Public URLs (must match what browsers and clients call)
OIDC_ISSUER=http://localhost:8000
OIDC_FRONTEND_ORIGIN=http://localhost:8000

# HTTP issuer turns insecure transport on by itself. An HTTPS issuer never does.
# OIDC_COOKIE_HTTPS_ONLY and OIDC_REQUIRE_ADMIN_MFA follow the issuer unless set.
OIDC_DEV=1
# Behind Caddy or nginx (deploy/Caddyfile, deploy/nginx.conf):
# OIDC_ALLOWED_HOSTS=auth.example.com
# OIDC_TRUSTED_PROXIES=127.0.0.1
# OIDC_ISSUER=https://auth.example.com
# OIDC_FRONTEND_ORIGIN=https://auth.example.com
# OIDC_APP_ORIGINS=https://app.example.com

OIDC_CONNECTOR=local

# Key for TOTP secrets at rest. Keep it outside ./data (e.g. a Docker secret).
# OIDC_SECRET_KEY=
# Initial admin password. An HTTPS issuer otherwise prints a random one at first start.
# OIDC_ADMIN_PASSWORD=
# Failed sign-ins per account per 10 minutes, all addresses combined
# OIDC_LOGIN_ACCOUNT_LIMIT=50

# Owner of the ./data bind mount. Use the host user: id -u / id -g
PUID=1000
PGID=1000

# Audit: rotate audit.jsonl at 10 MiB, keep 10 archives
OIDC_AUDIT_MAX_BYTES=10485760
OIDC_AUDIT_KEEP=10

# Initial session limits, in seconds. After the first start, Admin → Settings overrides them.
# Idle signs out after inactivity. Absolute signs out even while the session is in use.
# OIDC_SESSION_IDLE=1800
# OIDC_SESSION_ABSOLUTE=43200
# Days a trusted browser can skip MFA. 0 hides the checkbox. Admin → Settings overrides this too.
# OIDC_MFA_TRUST_DAYS=30

# LDAP (only when OIDC_CONNECTOR=ldap)
# LDAP_URL=ldaps://ldap:636
# LDAP_STARTTLS=0
# LDAP_ALLOW_INSECURE=0
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=secret
# LDAP_USER_BASE=ou=people,dc=example,dc=com
# LDAP_USER_FILTER=(uid={username})
# LDAP_GROUP_BASE=ou=groups,dc=example,dc=com
# LDAP_GROUP_FILTER=(objectClass=groupOfNames)
# LDAP_ADMIN_GROUP=admins
# LDAP_GROUP_ALLOWLIST=admins,users
# LDAP_CA_FILE=/etc/ssl/ldap-ca.pem
# LDAP_USER_ENABLED_FILTER=(!(userAccountControl:1.2.840.113556.1.4.803:=2))

# Published image override for compose
# OIDC_IMAGE=ghcr.io/<org>/simple-auth:1.0.0
